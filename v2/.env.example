# TeleSyriana V2 server-side configuration only.
# Never commit a real DATABASE_URL, employee login secret, or integration secret.
DATABASE_URL=postgresql://user:password@host:5432/telesyriana

# Use "require" for managed/cloud PostgreSQL providers that require TLS.
# Use "disable" only for trusted local development databases.
DATABASE_SSL=require

# Optional PostgreSQL pool size. Keep conservative for serverless providers.
DATABASE_POOL_MAX=10

# API server.
PORT=4000
NODE_ENV=development
# Production should use secure cookies over HTTPS. Set false only for local HTTP development.
COOKIE_SECURE=false

# One-time first CEO bootstrap. Remove these values from the deployment environment
# immediately after `npm run bootstrap:ceo` succeeds.
BOOTSTRAP_CEO_STAFF_CODE=replace-me
BOOTSTRAP_CEO_NAME=replace-me
BOOTSTRAP_CEO_EMAIL=
BOOTSTRAP_CEO_SECRET=replace-with-a-strong-temporary-secret
BOOTSTRAP_CEO_LOCALE=en
BOOTSTRAP_CEO_THEME=system
